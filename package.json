{
  "name": "cyberhire-desktop",
  "productName": "CyberHire",
  "version": "1.0.2",
  "description": "CyberHire \u2014 realistic AI interviews for SOC analyst and penetration tester roles, as a standalone Windows app.",
  "main": "electron/main.js",
  "author": "CyberHire",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:frontend": "cd frontend && npx --yes yarn@1.22.22 install --network-timeout 600000 && npx --yes yarn@1.22.22 build",
    "build:backend": "cd backend && pyinstaller --noconfirm soc-backend.spec",
    "dist:win": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.cyberhire.desktop",
    "productName": "CyberHire",
    "copyright": "CyberHire",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend/dist/soc-backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "frontend/dist",
        "to": "frontend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CyberHire",
      "artifactName": "CyberHire-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "CyberHire-Portable-${version}.${ext}"
    }
  }
}
